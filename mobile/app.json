{
  "expo": {
    "name": "Syntagma",
    "slug": "syntagma",
    "version": "1.0.0",
    "icon": "./assets/maskot.jpg",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./plugins/withAndroidNoBackup",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/maskot.jpg",
          "color": "#8B6508",
          "defaultChannel": "default"
        }
      ]
    ],
    "owner": "omerhanyigit",
    "android": {
      "package": "com.alpylmz4.syntagma",
      "adaptiveIcon": {
        "foregroundImage": "./assets/maskot.jpg",
        "backgroundColor": "#FFF8F0"
      },
      "notification": {
        "icon": "./assets/maskot.jpg",
        "color": "#8B6508"
      }
    },
    "extra": {
      "eas": {
        "projectId": "8cfaba0b-ced2-43d7-8047-1f30806c0a2d"
      }
    }
  }
}
